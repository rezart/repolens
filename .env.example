# Server
REPOLENS_DATA_DIR=./data
REPOLENS_API_TOKEN=change-me
REPOLENS_PORT=3000
REPOLENS_HOST=127.0.0.1
REPOLENS_PUBLIC_URL=http://localhost:3000

# LLM backend: openrouter | claude-cli (codex-cli is temporarily disabled)
LLM_PROVIDER=openrouter
# OpenRouter model id eligible for review price caps ($0.40/M input, $2/M output),
# or a Claude model name when using the CLI provider (blank = CLI default)
LLM_MODEL=qwen/qwen3-coder
# Ordered review-only alternatives; blank disables model fallback.
REVIEW_FALLBACK_MODELS=qwen/qwen3-coder-next
# OpenRouter model for security/high-risk hunk rechecks. Blank disables escalation.
# All initial, escalation, verification, and retry calls share the $0.495 ($0.50) review cap.
REVIEW_ESCALATION_MODEL=openai/gpt-5-mini
# Independent OpenRouter model for verifying findings; blank disables verification.
REVIEW_VERIFIER_MODEL=openai/gpt-5-mini
# Recheck verifier-uncertain findings with one focused call (true | false).
REVIEW_FOCUSED_VERIFICATION=false
# Run the independent contract/concurrency discovery view (true | false).
REVIEW_DUAL_DISCOVERY=false
OPENROUTER_API_KEY=
# The dashboard's Usage page prices calls from OpenRouter's public model list,
# fetched from this base URL (no key needed) and cached for a day.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Path to the Claude binary (default: found on PATH)
CLAUDE_BIN=claude
LLM_TIMEOUT_MS=300000
# Thinking budget for PR reviews: low | medium | high (blank = backend default).
# Chat never inherits this — it stays fast.
LLM_REASONING_EFFORT=

# Chat (codebase Q&A) backend. Reviews want depth, chat wants first tokens on
# screen fast, so chat can run on a smaller/cheaper model or a different CLI.
# Blank = same provider/model as the review backend above.
# CHAT_PROVIDER=claude-cli
CHAT_PROVIDER=
# e.g. `haiku` for the Claude CLI,
# `openai/gpt-4o-mini` or `anthropic/claude-haiku-4.5` for OpenRouter.
CHAT_MODEL=

# Embeddings: any OpenAI-compatible /embeddings endpoint. Leave EMBEDDING_MODEL blank
# to disable vector search and use lexical (BM25) retrieval only.
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=openai/text-embedding-3-small

# GitHub
# Personal token, or configure all three App fields below (App takes precedence).
GITHUB_TOKEN=
# Private GitHub App installed on this instance's account; tokens refresh automatically.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# PEM file on disk; keep outside git, e.g. ./data/github-app.pem.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
REVIEW_BOT_HANDLE=@repolens
# Poll GitHub every N seconds for new commits (reindex) and open PRs (review).
# Works without any inbound network access. 0 disables polling (webhooks only).
REPOLENS_POLL_INTERVAL=300
# Wait N seconds after the last push to a PR before reviewing it, so a flurry of
# commits costs one review instead of one per push. 0 reviews immediately.
REVIEW_SETTLE_SECONDS=300

# Extra attempts for failed OpenRouter reviews (0 disables retries and fallback).
# Retries share the total $0.25 review budget and stop when it cannot fit another call.
REVIEW_MAX_RETRIES=3
# Maximum output tokens for budgeted discovery (default 8000, maximum 16000).
REVIEW_DISCOVERY_MAX_OUTPUT=8000
# Comma-separated repository-relative globs to skip in pull request reviews.
REVIEW_IGNORE_PATTERNS=
