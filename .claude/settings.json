{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr merge *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/require-review.sh",
            "timeout": 30,
            "statusMessage": "Checking repolens/review status on the PR head"
          }
        ]
      }
    ]
  }
}
