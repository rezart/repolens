# Merge with existing private API/GitHub/observability settings on the host.
# Remove old API/provider/embedding keys and URLs; do not append to the old env.
MODEL_BILLING_MODE=subscription_only
SUBSCRIPTION_SOCKET_PATH=/run/software-factory/complete.sock
LLM_PROVIDER=subscription
LLM_MODEL=gpt-6.1-sol
LLM_REASONING_EFFORT=medium
LLM_TIMEOUT_MS=300000
CHAT_PROVIDER=subscription
CHAT_MODEL=gpt-6.1-sol
REVIEW_ESCALATION_MODEL=
# If escalation was already enabled, select an explicit native ID such as gpt-6-astra.
REVIEW_ESCALATION_REASONING_EFFORT=high
REVIEW_VERIFIER_MODEL=gpt-6.1-sol
REVIEW_VERIFIER_REASONING_EFFORT=medium
REVIEW_ARBITER_MODEL=gpt-6-astra
REVIEW_ARBITER_REASONING_EFFORT=low
REVIEW_FALLBACK_MODELS=
EMBEDDING_MODEL=
# Preserve existing thresholds, independent discovery, focused verification,
# arbiter policy, retry counts and repository/index registrations.
